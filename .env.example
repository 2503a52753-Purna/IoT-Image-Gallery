# ========================================================
# IoT Image Gallery - AWS Cloud Configuration (.env)
# ========================================================
# Fill in your AWS credentials and resource names below.
# If these are left blank, the application automatically runs
# in Local Simulation Mode.

# 1. AWS IAM Access Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: AWS_SESSION_TOKEN is required for AWS Academy / Learner Lab / temporary STS credentials
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# 2. AWS S3 Buckets
# Created via setup_aws.py or through AWS Console
AWS_RAW_BUCKET=
AWS_THUMBNAILS_BUCKET=

# 3. AWS Lambda Function Name
# Created via setup_aws.py or through AWS Console / SAM
AWS_LAMBDA_FUNCTION_NAME=IoTImageGalleryThumbnailer

# 4. Mode Toggle (true = Live AWS Cloud Mode, false = Local Simulation)
AWS_MODE=true
